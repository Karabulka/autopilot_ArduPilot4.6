<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="glider_visual_flight">
    <physics name="physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>
    <magnetic_field>4.96673326988e-06 2.4501664446e-05 -0.000042</magnetic_field>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="libFixedMagneticFieldSystem.so" name="glider_visual_nav::FixedMagneticFieldSystem" />
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.6 0.7 0.8 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0 0 -1</direction>
    </light>
    <include>
      <uri>model://visual_nav_ground</uri>
    </include>
    <include>
      <uri>model://glider_visual/arduplane.sdf</uri>
      <name>glider_visual</name>
      <pose>0 0 40.25 0 0 0</pose>
      <static>false</static>
    </include>
    <model name="launch_anchor">
      <static>true</static>
      <link name="anchor" />
    </model>
    <plugin filename="libFlightFixtureSystem.so" name="glider_visual_nav::FlightFixtureSystem">
      <model_name>glider_visual</model_name>
    </plugin>
  </world>
</sdf>